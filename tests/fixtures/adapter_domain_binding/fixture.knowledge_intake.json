{
 "adapter_id": "fixture.knowledge_intake",
 "adapter_version": "1.0.0",
 "workflow_version": "1.0.0",
 "retrieval_policy_version": "1.0.0",
 "input_schema_version": "1.0.0",
 "output_schema_version": "1.0.0",
 "description": "TEST FIXTURE (consolidation Phase 4): governed evidence rows become the domain's corpus rows, the domain selects lenses from them, the agent's interpretation is held to the domain's lineage law and returned to reasoning when it cites an unclassified or unknown row. Not a product adapter; never loaded from config/adapters.",
 "input_schema": {"type": "object", "required": ["seed", "corpus_ids"], "additionalProperties": false,
                  "properties": {"seed": {"type": "string", "minLength": 3, "maxLength": 2000}, "corpus_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1}}},
 "output_schema": {"type": "object"},
 "budgets": {"max_steps": 16, "max_agent_reason": 3, "max_branch_loops": 2, "max_external_operations": 0},
 "entry_step_id": "retrieve",
 "terminal_step_id": "compile",
 "steps": [
  {"step_id": "retrieve", "type": "POLYMATH_RETRIEVE", "title": "Knowledge through the evidence boundary", "next": "graph", "config": {"source": "input.seed"}},
  {"step_id": "graph", "type": "POLYMATH_GRAPH_EXPAND", "title": "Graph lane", "next": "intake", "config": {"source": "input.seed"}},
  {"step_id": "intake", "type": "DOMAIN_OPERATION", "title": "Governed rows become the domain's corpus rows", "next": "lenses",
   "config": {"domain": "ecommerce", "operation": "knowledge.corpus_evidence", "inputs": {"row_sets": ["outputs.retrieve.rows", "outputs.graph.rows"]}}},
  {"step_id": "lenses", "type": "DOMAIN_OPERATION", "title": "Lens selection", "next": "interpret",
   "config": {"domain": "ecommerce", "operation": "understanding.lenses", "inputs": {"signal": "input.seed", "corpus_evidence": "outputs.intake.corpus_evidence"}}},
  {"step_id": "interpret", "type": "AGENT_REASON", "title": "Interpret the knowledge", "next": "lineage",
   "objective": "Classify the rows you rely on in row_relevance, then state what the knowledge establishes, citing only classified rows. If a previous lineage check listed errors, correct them.",
   "output_schema": {"type": "object", "required": ["primitives"], "additionalProperties": false, "properties": {"primitives": {"type": "object"}}}},
  {"step_id": "lineage", "type": "DOMAIN_OPERATION", "title": "The domain's lineage law", "next": "route",
   "config": {"domain": "ecommerce", "operation": "understanding.validate_primitives",
              "inputs": {"primitives": "outputs.interpret.primitives", "corpus_evidence": "outputs.intake.corpus_evidence"}}},
  {"step_id": "route", "type": "BRANCH", "title": "An invalid interpretation returns through reasoning", "next": "compile",
   "branches": [{"label": "lineage errors and loop budget left",
                 "when": {"op": "all_of", "of": [{"op": "equals", "path": "steps.lineage.output.valid", "value": false},
                                                   {"op": "count_lt", "path": "run.branch_loops", "n": 2}]},
                 "next": "interpret"}]},
  {"step_id": "compile", "type": "COMPILE_RESULT", "title": "Compile the result", "next": null, "config": {"include": ["primitives", "lenses", "lineage"]}}
 ]
}
