{
 "adapter_id": "trail.product_discovery",
 "adapter_version": "2.2.0",
 "workflow_version": "2.0.0",
 "retrieval_policy_version": "2.0.0",
 "input_schema_version": "1.0.0",
 "output_schema_version": "2.1.0",
 "description": "Harness-executed product-opportunity discovery (ADR-0019): Polymath retrieves knowledge and owns durable hypothesis state; θ (the connected agent) generates, revises and splits hypotheses; TrailSignal projects its registry priors, compiles evidence gaps, admits harness observations, judges hypotheses (φ), qualifies product territory / market delta / supply and computes the only score (LAW 1); the host harness executes AGENT_RESEARCH, PRODUCT_REALITY_CHECK and SUPPLIER_RESEARCH actions with its own tools. No Trail-owned live-web acquisition is required; no search engine, browser or source SDK is named.",
 "evidence_roles": [
  "friction",
  "workaround",
  "behavior",
  "demand",
  "competition",
  "seasonality",
  "operations",
  "risk",
  "contradiction",
  "price",
  "supply"
 ],
 "input_schema": {
  "type": "object",
  "required": [
   "seed"
  ],
  "additionalProperties": false,
  "properties": {
   "seed": {
    "type": "string",
    "minLength": 3,
    "maxLength": 2000
   },
   "constraints": {
    "type": "array",
    "items": {
     "type": "string"
    }
   },
   "exclusions": {
    "type": "array",
    "items": {
     "type": "string"
    }
   },
   "corpus_ids": {
    "type": "array",
    "items": {
     "type": "string"
    }
   },
   "freshness_days": {
    "type": "integer",
    "minimum": 1,
    "maximum": 3650
   },
   "geography": {
    "type": "string"
   },
   "category": {
    "type": "string"
   }
  }
 },
 "output_schema": {
  "type": "object",
  "required": [
   "product_opportunity"
  ],
  "properties": {
   "product_opportunity": {
    "type": "object",
    "required": [
     "product_concept",
     "evidence_chain",
     "remaining_uncertainty",
     "cheapest_falsification_experiment"
    ],
    "properties": {
     "product_concept": {
      "type": "object"
     },
     "evidence_chain": {
      "type": "array"
     },
     "field_evidence": {
      "type": "array"
     },
     "contradictions": {
      "type": "array"
     },
     "competing_products": {
      "type": "array"
     },
     "product_delta": {
      "type": [
       "string",
       "null"
      ]
     },
     "supply": {
      "type": [
       "object",
       "null"
      ]
     },
     "trail_score": {
