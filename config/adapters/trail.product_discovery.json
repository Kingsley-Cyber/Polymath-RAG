   "type": "AGENT_REASON",
   "title": "θ re-reason with admitted field evidence",
   "theta_op": "cross_map_frictions",
   "next": "L_judge",
   "objective": "Reason again over the original knowledge, the hypothesis state and the newly admitted field evidence: propose REVISE or SPLIT transitions (citing admitted evidence ids), and name the gaps that remain open.",
   "constraints": [
    "Cite only evidence_refs supplied in context; registry priors (trail_prior) are coordinates, never evidence",
    "No opportunity score, rank or weight of any kind (LAW 1)",
    "Only admitted field_evidence ids may be cited as live-world evidence"
   ],
   "output_schema": {
