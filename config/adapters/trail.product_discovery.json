     }
    }
   },
   "hypothesis_ids": {
    "type": "array"
   },
   "qualification": {
    "type": "object"
   },
   "qualifications": {
    "type": "array"
   },
   "trail_scores": {
    "type": "array"
   },
   "score_refusals": {
    "type": "array"
   }
  }
 },
 "budgets": {
  "max_steps": 90,
  "max_agent_reason": 16,
  "max_branch_loops": 2,
  "max_external_operations": 30,
  "max_harness_actions": 6,
  "max_hypotheses": 8
 },
 "entry_step_id": "A_understand",
 "terminal_step_id": "X_compile",
 "steps": [
  {
   "step_id": "A_understand",
   "type": "VALIDATE",
   "title": "Understand seed: validate input and corpus scope",
   "next": "B_plan",
   "config": {
    "validate": "input_schema",
    "require_corpus": true
   }
  },
  {
   "step_id": "B_plan",
   "type": "POLYMATH_COMPILE_PLAN",
   "title": "Compile deterministic reformulations of the seed",
   "next": "B_retrieve",
   "config": {
    "source": "input.seed"
   }
  },
  {
   "step_id": "B_retrieve",
   "type": "POLYMATH_RETRIEVE",
   "title": "Retrieve chunks, parent context, mechanisms, known frictions, opposing evidence",
   "next": "B_graph",
   "config": {
    "surface": "evidence_boundary",
    "mode": "WILDCARD",
    "corpus_explorer": true,
    "max_calls": 3,
    "max_rows": 40,
    "fallback": "retrieve",
    "on_unavailable": "gap",
    "legacy_mode": "EXPLORE",
    "evidence": true,
    "top_k": 24,
    "source": "input.seed"
   }
  },
  {
   "step_id": "B_graph",
   "type": "POLYMATH_GRAPH_EXPAND",
   "title": "Graph expansion from the retrieved seeds",
   "next": "C_hypotheses",
   "config": {
    "surface": "evidence_boundary",
    "mode": "GRAPH",
    "corpus_explorer": false,
    "max_calls": 3,
    "max_rows": 40,
    "fallback": "retrieve",
    "on_unavailable": "gap",
    "max_seeds": 8,
    "max_facts": 20,
    "source": "input.seed"
   }
  },
  {
   "step_id": "C_hypotheses",
   "type": "AGENT_REASON",
   "title": "θ generate hypotheses",
   "theta_op": "generate_hypotheses",
   "next": "D_project",
   "objective": "From the retrieved Polymath evidence only, generate up to 8 latent hypotheses: a population doing a repeated activity meets a recurring friction with a plausible mechanism. State assumptions, falsifiers and the knowledge gaps that only the live world can close. Cite evidence ids for every hypothesis; list unknowns instead of inventing.",
   "constraints": [
    "Cite only evidence_refs supplied in context; registry priors (trail_prior) are coordinates, never evidence",
    "No opportunity score, rank or weight of any kind (LAW 1)",
    "Preserve contradictions with their evidence ids"
   ],
   "output_schema": {
    "type": "object",
    "required": [
     "hypotheses"
    ],
    "additionalProperties": false,
    "properties": {
     "hypotheses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
       "type": "object",
       "required": [
        "statement",
        "supporting_evidence_ids"
       ],
       "additionalProperties": false,
       "properties": {
        "statement": {
         "type": "string",
         "minLength": 8,
         "maxLength": 2000
        },
        "mechanism": {
         "type": [
          "string",
          "null"
         ]
        },
        "population": {
         "type": [
          "string",
          "null"
         ]
        },
        "activity": {
         "type": [
          "string",
          "null"
         ]
        },
        "task": {
         "type": [
          "string",
          "null"
         ]
        },
        "context": {
         "type": [
          "string",
          "null"
         ]
        },
        "suspected_friction": {
         "type": [
          "string",
          "null"
         ]
        },
        "supporting_evidence_ids": {
         "type": "array",
         "items": {
          "type": "string"
         },
         "minItems": 1
        },
        "support_roles": {
         "type": "object"
        },
        "contradictions": {
         "type": "array",
         "items": {
          "type": "object",
          "required": [
           "statement",
           "evidence_ids"
          ],
          "properties": {
           "statement": {
            "type": "string"
           },
           "evidence_ids": {
            "type": "array",
            "items": {
             "type": "string"
            }
           }
          }
         }
        },
        "assumptions": {
         "type": "array",
         "items": {
          "type": "string"
