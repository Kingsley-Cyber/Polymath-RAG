{
 "title": "lived_evidence_cluster",
 "description": "LivedEvidenceCluster (docs/25 \u00a73): participant cards grouped by community and friction family. Authority comes from INDEPENDENT records and threads: ANCHOR at or above policies.lived_world.anchor_threshold, THIN below (may feed explicit reconstruction only).",
 "required": [
  "id",
  "community",
  "friction_family",
  "card_ids",
  "record_ids",
  "record_count",
  "thread_count",
  "independent_voices",
  "authority",
  "unknowns"
 ],
