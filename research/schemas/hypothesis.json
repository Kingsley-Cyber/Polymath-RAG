{
 "title": "hypothesis",
 "required": [
  "id",
  "source",
  "path",
  "target_mechanism",
  "evidence_boundary",
  "gaps",
  "status",
  "alternatives",
  "falsifiers"
 ],
 "properties": {
  "status": {
   "enum": [
    "WORKING_HYPOTHESIS",
    "WORKING_ANALOGY",
    "CHALLENGED",
    "SUPPORTED",
