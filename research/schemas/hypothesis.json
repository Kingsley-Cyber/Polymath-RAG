   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "source_refs": {
   "description": "corpus evidence refs grounding hops before the boundary",
   "type": "array"
  },
  "genesis": {
   "enum": [
    "PROBLEM_LED",
    "SHIFT_LED",
    "TREND_LED",
    "DEMAND_REROUTE",
    "CAPABILITY_LED",
    "WORKAROUND_LED",
    "COMMUNITY_LED",
    "SUPPLY_TRANSFER_LED"
   ]
  },
  "id": {
   "type": "string"
  },
  "source": {
   "type": "string"
  },
  "path": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "target_mechanism": {
   "type": "string"
  },
  "gaps": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
