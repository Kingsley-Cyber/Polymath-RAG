{
  "$id": "https://polymath.local/contracts/extraction/v1/gliner_rescue.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GLiNER targeted rescue queries (I4R)",
  "description": "Batched re-queries against the resident pinned GLiNER model. The caller sends EXACTLY the target phrase per item (deterministic alignment code decides what to ask); acceptance is exact-full-span-only at the caller. Deterministic rescue request identity = sha256(rescue-v1|kind|model_revision|threshold|text|ordered labels) and is recorded in provenance.",
  "$defs": {
    "request_item": {
      "type": "object",
      "required": ["text", "labels"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "labels": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "threshold": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.5}
      },
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "required": ["requests"],
      "properties": {
        "requests": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/request_item"}}
      },
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "required": ["results", "model_release"],
      "properties": {
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["text", "spans"],
            "properties": {
              "text": {"type": "string"},
              "spans": {"type": "array", "items": {"$ref": "gliner_infer.schema.json#/$defs/span"}}
            },
            "additionalProperties": false
          }
        },
        "model_release": {"type": "string"}
      },
      "additionalProperties": false
    }
  }
}
