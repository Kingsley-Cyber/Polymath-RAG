{
  "$id": "https://polymath.local/contracts/answer/v2/chat_response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChatResponse",
  "description": "R3b output of POST /chat (v2, typed support lanes): grounded answer prose, citations that reference R3a EvidenceBundle items (bundle_item_ids, not merely documents), and the validated claim ledger. Graph claims (lane=graph) render as factual sentences; text evidence (lane=text) renders as cited passages. Either lane may support the answer independently; graph augments text, never gates it. Unsupported claims are reported with status 'unsupported' and never render into 'answer'. Abstention only when BOTH lanes are empty. Generated by shared/polymath_shared/answer_synthesis.py.",
  "type": "object",
  "required": ["answer", "citations", "claims", "meta"],
  "properties": {
    "answer": {"type": "string"},
    "citations": {
      "type": "array",
      "items": {"$ref": "#/$defs/citation"}
    },
    "claims": {
      "type": "array",
      "items": {"$ref": "#/$defs/claim"}
    },
    "meta": {
      "type": "object",
      "required": ["contract_id", "synthesis_version"],
      "properties": {
        "contract_id": {"type": "string"},
        "synthesis_version": {"type": "string"},
        "abstained": {"type": "boolean"},
        "supported_claim_count": {"type": "integer", "minimum": 0},
        "unsupported_claim_count": {"type": "integer", "minimum": 0},
        "text_support_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "citation": {
      "type": "object",
      "required": ["citation_id", "bundle_item_ids", "source_document_ids", "locators"],
      "properties": {
        "citation_id": {"type": "integer", "minimum": 1},
        "bundle_item_ids": {
          "description": "R3a EvidenceBundle item ids this citation points at.",
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1
        },
        "source_document_ids": {"type": "array", "items": {"type": "string"}},
        "locators": {
          "description": "Exact source span locators from the supporting bundle items.",
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "required": ["text", "support", "status"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "support": {
          "description": "Bundle item ids that support this claim.",
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1
        },
        "lane": {
          "description": "Support lane of this claim: 'graph' (fact claims) or 'text' (verbatim passages).",
          "enum": ["graph", "text"]
        },
        "status": {"enum": ["supported", "unsupported"]},
        "conflicts_with": {"type": "array", "items": {"type": "string"}},
        "epistemics": {
          "type": "object",
          "properties": {
            "certainty": {"type": ["string", "null"]},
            "attributed": {"type": ["boolean", "null"]},
            "attribution_source": {"type": ["string", "null"]},
            "conditional": {"type": ["boolean", "null"]},
            "negated": {"type": ["boolean", "null"]}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
