{
  "$id": "https://polymath.local/contracts/answer/v1/evidence_bundle.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvidenceBundle",
  "description": "R3a output: a deterministic bundle where every candidate claim is traceable to fact/entity IDs, source document, exact evidence span, provenance, epistemics, applicability, and retrieval lane. Assembled by shared/polymath_shared/evidence_assembly.py; served by POST /evidence. Items of kind 'claim' carry fact-backed claims with full provenance. Items of kind 'evidence' are retrieved chunks without a fact: they are supporting context, NOT claims (claim_candidate is null). R3a assembles evidence; it never decides final answer prose (R3b).",
  "type": "object",
  "required": ["query", "evidence_bundle"],
  "properties": {
    "query": {"type": "string"},
    "evidence_bundle": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidence_item"}
    },
    "meta": {
      "type": "object",
      "properties": {
        "contract_id": {"type": "string"},
        "assembly_version": {"type": "string"},
        "ordering": {
          "description": "Ordering policy: identity (R3a default) or rerank (G3 candidate ordering hint).",
          "enum": ["identity", "rerank"]
        },
        "claim_count": {"type": "integer", "minimum": 0},
        "evidence_count": {"type": "integer", "minimum": 0}
      },
      "required": ["contract_id", "assembly_version", "ordering"]
    }
  },
  "$defs": {
    "evidence_item": {
      "type": "object",
      "required": [
        "kind",
        "claim_candidate",
        "knowledge_id",
        "fact_id",
        "entity_ids",
        "predicate",
        "source_document_id",
        "source_span",
        "provenance",
        "epistemics",
        "applicability",
        "retrieval"
      ],
      "properties": {
        "kind": {"enum": ["claim", "evidence"]},
        "claim_candidate": {
          "description": "Subject PREDICATE object surface for claims; null for evidence-only items (no synthetic claims).",
          "type": ["string", "null"]
        },
        "knowledge_id": {
          "description": "Stable knowledge identifier: fact_id for claims, chunk_id for evidence-only items.",
          "type": ["string", "null"]
        },
        "fact_id": {"type": ["string", "null"]},
        "entity_ids": {
          "type": ["object", "null"],
          "properties": {
            "subject_id": {"type": "string"},
            "object_id": {"type": "string"}
          },
          "required": ["subject_id", "object_id"],
          "additionalProperties": false
        },
        "predicate": {"type": ["string", "null"]},
        "source_document_id": {"type": "string"},
        "source_span": {"$ref": "#/$defs/source_span"},
        "provenance": {"type": "object"},
        "epistemics": {"$ref": "#/$defs/epistemics"},
        "applicability": {"$ref": "#/$defs/applicability"},
        "retrieval": {
          "type": "object",
          "required": ["lanes", "score"],
          "properties": {
            "lanes": {"type": "array", "items": {"type": "string"}},
            "score": {"type": ["number", "null"]}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "source_span": {
      "type": "object",
      "required": ["text", "locator", "chunk_id", "char_start", "char_end", "offsets_source"],
      "properties": {
        "text": {"type": "string"},
        "locator": {
          "description": "Deterministic locator: chunk:<chunk_id>@<char_start>:<char_end> (document-level offsets).",
          "type": "string"
        },
        "chunk_id": {"type": ["string", "null"]},
        "char_start": {"type": ["integer", "null"]},
        "char_end": {"type": ["integer", "null"]},
        "offsets_source": {
          "description": "Granularity of persisted offsets; currently 'chunk' (finer offsets are an extraction change, out of R3a scope).",
          "type": ["string", "null"]
        },
        "span_offsets": {
          "description": "Raw persisted span offsets (evidence.span_offsets JSONB), uninterpreted.",
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "epistemics": {
      "type": "object",
      "required": ["decision"],
      "properties": {
        "decision": {
          "description": "facts.decision for claims; 'evidence' for evidence-only items.",
          "enum": ["ACCEPT", "QUALIFY", "REJECT", "AMBIGUOUS", "UNSUPPORTED", "CONFLICT", "evidence"]
        },
        "certainty": {"type": ["string", "null"]},
        "negated": {"type": ["boolean", "null"]},
        "attributed": {"type": ["boolean", "null"]},
        "attribution_source": {"type": ["string", "null"]},
        "comparison": {"type": ["boolean", "null"]},
        "valid_from": {"type": ["string", "null"]},
        "valid_until": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "applicability": {
      "type": "object",
      "required": ["corpus_id", "source_name", "conditions"],
      "properties": {
        "corpus_id": {"type": ["string", "null"]},
        "source_name": {"type": ["string", "null"]},
        "conditions": {
          "description": "Deterministic scope conditions (speculative, hypothetical, attributed, conditional, comparison, question).",
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    }
  }
}
