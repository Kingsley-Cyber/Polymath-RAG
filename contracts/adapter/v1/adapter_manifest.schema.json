{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "polymath/contracts/adapter/v1/adapter_manifest.schema.json",
 "title": "AdapterManifestV1",
 "description": "A versioned, admitted cognitive adapter: identity, schema versions, the CLOSED-vocabulary step list (nine types since ADR-0019: HARNESS_ACTION hands live-world research to the host harness), branch predicates, budgets and the typed theta/phi cognitive operations. Semantic workflow only \u2014 no executable definitions, no caller-supplied code, no source-specific branches.",
 "type": "object",
 "required": [
  "adapter_id",
  "adapter_version",
  "workflow_version",
  "retrieval_policy_version",
  "input_schema_version",
  "output_schema_version",
  "budgets",
  "entry_step_id",
  "terminal_step_id",
  "steps"
 ],
 "properties": {
  "adapter_id": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
  },
  "adapter_version": {
   "type": "string",
   "pattern": "^\\d+\\.\\d+\\.\\d+$"
  },
  "workflow_version": {
   "type": "string",
   "pattern": "^\\d+\\.\\d+\\.\\d+$"
  },
  "retrieval_policy_version": {
   "type": "string",
   "pattern": "^\\d+\\.\\d+\\.\\d+$"
  },
  "input_schema_version": {
   "type": "string",
   "pattern": "^\\d+\\.\\d+\\.\\d+$"
  },
  "output_schema_version": {
   "type": "string",
   "pattern": "^\\d+\\.\\d+\\.\\d+$"
  },
  "description": {
   "type": "string",
   "maxLength": 2000
  },
  "input_schema": {
   "type": "object"
  },
  "output_schema": {
   "type": "object"
  },
  "budgets": {
   "type": "object",
   "required": [
    "max_steps",
    "max_agent_reason",
    "max_branch_loops"
   ],
   "additionalProperties": false,
   "properties": {
    "max_steps": {
     "type": "integer",
     "minimum": 1,
     "maximum": 500
    },
    "max_agent_reason": {
     "type": "integer",
     "minimum": 0,
     "maximum": 200
    },
    "max_branch_loops": {
     "type": "integer",
     "minimum": 0,
     "maximum": 50
    },
    "max_external_operations": {
     "type": "integer",
     "minimum": 0,
     "maximum": 500
    },
    "max_harness_actions": {
     "type": "integer",
     "minimum": 0,
     "maximum": 100
    },
    "max_hypotheses": {
     "type": "integer",
     "minimum": 1,
     "maximum": 64
    }
   }
  },
  "entry_step_id": {
   "type": "string",
   "minLength": 1,
   "maxLength": 200
  },
  "terminal_step_id": {
   "type": "string",
   "minLength": 1,
   "maxLength": 200
  },
  "steps": {
   "type": "array",
   "minItems": 2,
   "items": {
    "$ref": "#/$defs/step_def"
   }
  },
  "evidence_roles": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^[a-z][a-z0-9_]{1,40}$"
   },
   "uniqueItems": true,
   "description": "the closed evidence-role vocabulary this adapter's harness actions, receipts and admissions may use (domain data, declared here, never in runtime code)"
  }
 },
 "additionalProperties": false,
 "$defs": {
  "predicate": {
   "type": "object",
   "required": [
    "op"
   ],
   "additionalProperties": false,
   "properties": {
    "op": {
     "enum": [
      "exists",
      "count_gte",
      "count_lt",
      "equals",
      "all_of",
      "any_of"
     ]
    },
    "path": {
     "type": "string"
    },
    "value": {},
    "n": {
     "type": "integer",
     "minimum": 0
    },
    "of": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/predicate"
     }
    }
   }
  },
  "step_def": {
   "type": "object",
   "required": [
    "step_id",
    "type",
    "title"
   ],
   "additionalProperties": false,
   "properties": {
    "step_id": {
     "type": "string",
     "minLength": 1,
     "maxLength": 200
    },
    "type": {
     "enum": [
      "POLYMATH_RETRIEVE",
      "POLYMATH_COMPILE_PLAN",
      "POLYMATH_GRAPH_EXPAND",
      "EXTERNAL_OPERATION",
      "AGENT_REASON",
      "HARNESS_ACTION",
      "VALIDATE",
      "BRANCH",
      "COMPILE_RESULT"
     ]
    },
    "title": {
     "type": "string",
     "maxLength": 300
    },
    "objective": {
     "type": "string",
     "maxLength": 4000
    },
    "next": {
     "type": [
      "string",
      "null"
     ]
    },
    "config": {
     "type": "object"
    },
    "output_schema": {
     "type": "object"
    },
    "acceptance_rules": {
     "type": "array",
     "items": {
      "type": "string",
      "maxLength": 500
     }
    },
    "constraints": {
     "type": "array",
     "items": {
      "type": "string",
      "maxLength": 500
     }
    },
    "branches": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "when",
       "next"
      ],
      "additionalProperties": false,
      "properties": {
       "when": {
        "$ref": "#/$defs/predicate"
       },
       "next": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
       },
       "label": {
        "type": "string"
       }
      }
     }
    },
    "external": {
     "type": "object",
     "required": [
      "system",
      "operation_kind"
     ],
     "additionalProperties": false,
     "properties": {
      "system": {
       "enum": [
        "trailsignal"
       ]
      },
      "operation_kind": {
       "type": "string"
      },
      "availability": {
       "enum": [
        "working",
        "planned"
       ]
      },
      "planned_node": {
       "type": "string"
      }
     }
    },
    "cognitive_op": {
     "enum": [
      "theta",
      "phi"
     ]
    },
    "theta_op": {
     "$ref": "#/$defs/theta_op"
    },
    "harness": {
     "type": "object",
     "required": [
      "action_kind"
     ],
     "additionalProperties": false,
     "properties": {
      "action_kind": {
       "$ref": "#/$defs/harness_action_kind"
      },
      "preferred_source_roles": {
       "type": "array",
       "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
       },
       "minItems": 0,
       "maxItems": 50
      },
      "disallowed_source_roles": {
       "type": "array",
       "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
       },
       "minItems": 0,
       "maxItems": 50
      },
      "minimum_independent_sources": {
       "type": "integer",
       "minimum": 1,
       "maximum": 100
      },
      "freshness_max_age_days": {
       "type": [
        "integer",
        "null"
       ],
       "minimum": 1
      },
      "budget": {
       "type": "object",
       "required": [
        "max_queries",
        "max_sources",
        "max_observations"
       ],
       "additionalProperties": false,
       "properties": {
        "max_queries": {
         "type": "integer",
         "minimum": 1,
         "maximum": 500
        },
        "max_sources": {
         "type": "integer",
         "minimum": 1,
         "maximum": 200
        },
        "max_observations": {
         "type": "integer",
         "minimum": 1,
         "maximum": 1000
        }
       }
      }
     }
    }
   }
  },
  "harness_action_kind": {
   "enum": [
    "AGENT_RESEARCH",
    "PRODUCT_REALITY_CHECK",
    "SUPPLIER_RESEARCH"
   ]
  },
  "theta_op": {
   "enum": [
    "generate_hypotheses",
    "derive_mechanisms",
    "cross_map_frictions",
    "derive_physical_jobs",
    "derive_analogies",
    "split_hypotheses",
    "generate_product_mechanisms"
   ]
  }
 }
}
