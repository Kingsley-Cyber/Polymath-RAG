{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "polymath/contracts/adapter/v1/adapter_submission.schema.json",
 "title": "AdapterSubmissionV1",
 "description": "adapter_submit payload for an AGENT_REASON step: the structured result plus who produced it. Validated against the step's output_schema and acceptance rules before the run advances.",
 "type": "object",
 "required": [
  "run_id",
  "step_id",
  "payload",
  "submitted_by"
 ],
 "properties": {
  "run_id": {
   "type": "string",
   "pattern": "^adr_[0-9a-f]{16,64}$"
  },
  "step_id": {
   "type": "string",
   "minLength": 1,
   "maxLength": 200
  },
  "payload": {
   "type": "object"
  },
  "submitted_by": {
   "type": "object",
   "required": [
    "agent_identity"
   ],
   "additionalProperties": false,
   "properties": {
    "agent_identity": {
     "type": "string",
     "minLength": 1,
     "maxLength": 200
    },
    "model": {
     "type": "string",
     "maxLength": 200
    }
   }
  },
  "submitted_at": {
   "type": "string",
   "format": "date-time"
  },
  "submission_hash": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  }
 },
 "additionalProperties": false
}
