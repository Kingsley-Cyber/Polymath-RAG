{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "polymath/contracts/adapter/v1/adapter_run_ref.schema.json",
 "title": "AdapterRunRefV1",
 "description": "The durable handle returned by adapter_start.",
 "type": "object",
 "required": [
  "run_id",
  "adapter_id",
  "adapter_version",
  "workflow_version",
  "created_at",
  "status"
 ],
 "properties": {
  "run_id": {
   "type": "string",
   "pattern": "^adr_[0-9a-f]{16,64}$"
  },
  "adapter_id": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
  },
  "adapter_version": {
   "type": "string",
   "pattern": "^\\d+\\.\\d+\\.\\d+$"
  },
  "workflow_version": {
   "type": "string",
   "pattern": "^\\d+\\.\\d+\\.\\d+$"
  },
  "created_at": {
   "type": "string",
   "format": "date-time"
  },
  "status": {
   "enum": [
    "created",
    "running",
    "awaiting_agent",
    "awaiting_harness",
    "completed",
    "terminal_gap",
    "cancelled",
    "failed"
   ]
  }
 },
 "additionalProperties": false
}
