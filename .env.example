# Environment template. Copy to .env and fill in.

# Postgres (the workflow authority — ADR-0002)
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=polymath
POSTGRES_USER=polymath
POSTGRES_PASSWORD=__generate__

# Qdrant (vector projection — rebuildable, Phase F)
QDRANT_IMAGE=qdrant/qdrant:v1.13.4
QDRANT_URL=http://127.0.0.1:6333

# Neo4j (graph projection — rebuildable, Phase F)
NEO4J_IMAGE=neo4j:5.26-community
NEO4J_URI=bolt://127.0.0.1:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=__generate__

# Redis (notification layer — disposable, ADR-0002)
REDIS_IMAGE=redis:7-alpine
REDIS_URL=redis://127.0.0.1:6379

# Polymath runtime (typed settings — shared/polymath_shared/settings.py)
POLYMATH_ENV=local
POLYMATH_LOG_LEVEL=INFO
POLYMATH_PG_DSN=postgresql://polymath:__generate__@127.0.0.1:5432/polymath
POLYMATH_QDRANT_URL=http://127.0.0.1:6333
POLYMATH_NEO4J_URI=bolt://127.0.0.1:7688
POLYMATH_NEO4J_USER=neo4j
POLYMATH_NEO4J_PASSWORD=__generate__
POLYMATH_GLINER_URL=http://127.0.0.1:8740
POLYMATH_EMBEDDER_URL=http://127.0.0.1:8742
POLYMATH_RERANKER_URL=http://127.0.0.1:8743
POLYMATH_CONTROL_TICK_INTERVAL_S=10
POLYMATH_CONTROL_LEASE_TTL_S=30
POLYMATH_CONTROL_MAX_ATTEMPTS=3
POLYMATH_WORKER_POLL_INTERVAL_S=2
POLYMATH_WORKER_BATCH_SIZE=8

# GLiNER runtime (host-native, mps by default; cpu is an explicit fallback)
POLYMATH_GLINER_DEVICE=mps
# Set to 1 in production once Phase C records the weights digest in the manifest.
POLYMATH_REQUIRE_PINNED=0
