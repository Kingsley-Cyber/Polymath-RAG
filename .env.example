# Environment template. Copy to .env and fill in.

# Postgres (the workflow authority — ADR-0002)
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=polymath
POSTGRES_USER=polymath
POSTGRES_PASSWORD=__generate__

# Qdrant (vector projection — rebuildable, Phase F)
QDRANT_IMAGE=qdrant/qdrant:v1.13.4
QDRANT_URL=http://127.0.0.1:6334

# Neo4j (graph projection — rebuildable, Phase F)
NEO4J_IMAGE=neo4j:5.26-community
NEO4J_URI=bolt://127.0.0.1:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=__generate__

# Redis (notification layer — disposable, ADR-0002)
REDIS_IMAGE=redis:7-alpine
REDIS_URL=redis://127.0.0.1:6379

# Polymath runtime (typed settings — shared/polymath_shared/settings.py)
POLYMATH_ENV=local
POLYMATH_LOG_LEVEL=INFO
POLYMATH_PG_DSN=postgresql://polymath:__generate__@127.0.0.1:5432/polymath
POLYMATH_QDRANT_URL=http://127.0.0.1:6334
POLYMATH_NEO4J_URI=bolt://127.0.0.1:7688
POLYMATH_NEO4J_USER=neo4j
POLYMATH_NEO4J_PASSWORD=__generate__
POLYMATH_EMBEDDER_URL=http://127.0.0.1:8742
POLYMATH_RERANKER_URL=http://127.0.0.1:8743
# Free-LLM documents this Ollama endpoint pattern. It remains disconnected
# from ingestion until LOCAL-LLM-EXTRACTION-V1 defines the extraction schema.
# Enable only after `ollama list` shows a downloaded local model.
POLYMATH_LOCAL_LLM_PROVIDER=disabled
POLYMATH_LOCAL_LLM_URL=http://127.0.0.1:11434
POLYMATH_LOCAL_LLM_MODEL=
POLYMATH_CONTROL_TICK_INTERVAL_S=10
POLYMATH_CONTROL_LEASE_TTL_S=30
POLYMATH_CONTROL_MAX_ATTEMPTS=3
POLYMATH_WORKER_POLL_INTERVAL_S=2
POLYMATH_WORKER_BATCH_SIZE=8

# LLM-DIRECT-CANON (ADR-0017, 2026-09-03): llm_live is the ONLY extraction
# provider; the GLiNER/spaCy/rule-pack path is deleted. The LLM gate
# (shared/polymath_shared/llm_extraction/gate.py) is the sole durability
# authority. Endpoint attestation is a recorded LEVEL under 'tiered';
# 'strict' restores the pre-canon quote/anchor-only rule (A/B knob).
# Query policy is part of the execution contract; v1 is the default every
# live run pins. Setting v3 (alias canonicalisation) makes every run stale.
# POLYMATH_QUERY_POLICY=semantic-query-policy-v1
POLYMATH_WORKER_EXTRACTION_PROVIDER=llm_live
POLYMATH_EXTRACTION_ATTESTATION=tiered
# CLOUD-FIRST-V1 (owner 2026-09-02): the byte threshold is a THROUGHPUT
# router between the local and cloud lanes, not a privacy boundary; 0 sends
# every document to the cloud lane, the local lane assists.
POLYMATH_WORKER_CLOUD_MIN_BYTES=0
# Local extraction lane = supervised `local_extractor` slot (MLX, port 8755);
# its memory budget inside config/runtime_budget.yaml:
POLYMATH_LLM_LOCAL_MEMORY_GB=10
POLYMATH_LLM_LOCAL_EXTRACT_URL=http://127.0.0.1:8755
POLYMATH_LLM_LOCAL_EXTRACT_MODEL=mlx-community/Qwen3.5-4B-MLX-4bit
POLYMATH_LLM_CLOUD_URL=http://127.0.0.1:11434
POLYMATH_LLM_CLOUD_MODEL=qwen3.5:397b-cloud

# Set to 1 in production once Phase C records the weights digest in the manifest.
POLYMATH_REQUIRE_PINNED=0
POLYMATH_EMBEDDING_CONTRACT_ID=hash-embed-v1
POLYMATH_EMBEDDER_URL=http://127.0.0.1:8742

