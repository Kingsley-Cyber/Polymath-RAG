<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>ai.polymath.gliner</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PY__</string>
    <string>-m</string>
    <string>uvicorn</string>
    <string>server:app</string>
    <string>--host</string><string>127.0.0.1</string>
    <string>--port</string><string>8740</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO__/sidecars/gliner_runtime</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>__REPO__/var/log/gliner.log</string>
  <key>StandardErrorPath</key><string>__REPO__/var/log/gliner.err.log</string>
  <key>ThrottleInterval</key><integer>5</integer>
</dict>
</plist>
